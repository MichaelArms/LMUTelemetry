<Window x:Class="LmuTelemetryDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMU Race Engineer - Telemetry Analyzer"
        Height="850" Width="1400"
        Background="#1B1B1C" Foreground="White">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Apri file .duckdb" Width="170" Height="36" Margin="0,0,8,0" Click="OpenDuckDb_Click"/>
            <Button Content="Esporta CSV (Excel)" Width="170" Height="36" Margin="0,0,8,0" Click="ExportCsv_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="13" Foreground="#7FE07F" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- Selettori canale -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Canali:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
            <CheckBox x:Name="ChkSpeed"    Content="Speed"    IsChecked="True"  VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
            <CheckBox x:Name="ChkThrottle" Content="Throttle" IsChecked="True"  VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
            <CheckBox x:Name="ChkBrake"    Content="Brake"    IsChecked="True"  VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
            <CheckBox x:Name="ChkSteering" Content="Steering" IsChecked="False" VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
            <CheckBox x:Name="ChkRpm"      Content="RPM"      IsChecked="False" VerticalAlignment="Center" Margin="0,0,14,0" Click="Channel_Click" Foreground="White"/>
        </StackPanel>

        <!-- Info sessione -->
        <TextBlock Grid.Row="2" x:Name="SessionInfo" FontSize="13" Foreground="#B0B0B0" Margin="0,0,0,8"/>

        <!-- Contenuto principale -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pannello sinistro -->
            <Border Grid.Column="0" Background="#252528" BorderBrush="#3A3A3E" BorderThickness="1" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Giri sessione (max 2)" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" Margin="8,8,8,4"/>

                    <ListBox Grid.Row="1" x:Name="LapList"
                             SelectionMode="Multiple"
                             SelectionChanged="LapList_SelectionChanged"
                             Background="#252528" Foreground="White" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding LapNumber, StringFormat='Lap {0}'}"
                                               FontWeight="SemiBold" Margin="0,0,8,0" Foreground="White"/>
                                    <TextBlock Text="{Binding LapTimeFormatted}" Foreground="#A0A0A5"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" x:Name="BtnSaveLap" Content="Salva giro selezionato"
                            Height="30" Margin="8,6" Click="SaveLap_Click" IsEnabled="False"/>

                    <TextBlock Grid.Row="3" Text="Giri salvati (libreria)" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" Margin="8,10,8,4"/>

                    <ListBox Grid.Row="4" x:Name="SavedList"
                             SelectionMode="Multiple"
                             SelectionChanged="SavedList_SelectionChanged"
                             Background="#252528" Foreground="White" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Foreground="White" FontWeight="SemiBold">
                                        <Run Text="{Binding CarName}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding LapTimeFormatted}" Foreground="#A0A0A5"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="#7A7A80">
                                        <Run Text="{Binding TrackName}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding DisplayDate}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="5" x:Name="TrackRefText" FontSize="10" Foreground="#7FE07F"
                               TextWrapping="Wrap" Margin="8,6"/>
                </Grid>
            </Border>

            <!-- Grafico -->
            <Border Grid.Column="1" Background="#212124" BorderBrush="#3A3A3E" BorderThickness="1">
                <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
            </Border>
        </Grid>
    </Grid>
</Window>